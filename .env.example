# ═══════════════════════════════════════════════════════════════════════════════
# Oceanway Tours (Pvt) Ltd - Environment Variables Configuration
# ═══════════════════════════════════════════════════════════════════════════════

# ── Server & Application ─────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── OpenRouter AI (Rate Sheet Document Analysis & Extraction) ─────
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash

# ── Discord Notifications (Live Inquiries & Hotel Alerts) ────────
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ── Travel Agency Legal Profile ──────────────────────────────────
TRAVEL_AGENCY_NAME="Oceanway Tours (Pvt) Ltd"
COMPANY_REGISTRATION_NUMBER="PV 00380121"
TRAVEL_AGENCY_CONTACT="Inbound Contracting & Reservations Desk"
TRAVEL_AGENCY_PHONE="+94 76 363 4022"

# ── Hostinger Business SMTP (Outgoing B2B Inquiries) ─────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=b2b@oceanwaytours.com
SMTP_PASS=your_email_password_here

# ── Hostinger Business IMAP (Incoming Rate Sheet Harvesting) ──────
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=b2b@oceanwaytours.com
IMAP_PASS=your_email_password_here

# ── WhatsApp Automation ──────────────────────────────────────────
# Sender bot phone number (the account that logs in and sends):
BOT_WHATSAPP_NUMBER=94760602638
# Destination WhatsApp number (where incoming rate sheets are forwarded):
ADMIN_WHATSAPP_NUMBER=94711770186
# Secondary WhatsApp delivery destination (e.g. +966 53 781 3155):
SECONDARY_WHATSAPP_NUMBER=966537813155
WHATSAPP_AUTO_SEND=true

# ── Storage Directories ──────────────────────────────────────────
RATE_SHEETS_DIR=rate_sheets
